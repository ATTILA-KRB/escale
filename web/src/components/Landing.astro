---
import '../styles/global.css';
import Shot from './Shot.astro';
import { hasMedia, shot, hasOgImage } from '../lib/shots';
import { fr } from '../i18n/fr';
import { en } from '../i18n/en';
import release from '../release.json';
import { SUPPORT_URL } from '../lib/support';

interface Props {
  locale: 'fr' | 'en';
}
const { locale } = Astro.props;
const t = locale === 'en' ? en : fr;
const base = locale === 'en' ? '/en' : '';
// DMG servi par le site (public/updates, déposé par scripts/publish.sh) ; surchargeable par variable.
const downloadURL = import.meta.env.PUBLIC_DOWNLOAD_URL || `/updates/${release.dmg}`;
const canonical = new URL(base || '/', Astro.site).href;
const alternates = [
  { lang: 'fr', href: new URL('/', Astro.site).href },
  { lang: 'en', href: new URL('/en', Astro.site).href },
];
// Tasse (page de dons) : même tracé dans la barre des menus, le héros, le Dock et le bloc Téléchargement.
const cup = 'M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9Zm13 1h1.5a2.5 2.5 0 0 1 0 5H17M8 3v3m4-3v3';
// Icônes sobres des tuiles sans capture (grille 24, trait).
const tileIcons: Record<string, string> = {
  monitoring: 'M4 20h16M7 16v-4m5 4V7m5 9v-6',
  reconnect: 'M20 12a8 8 0 1 1-2.5-5.8M20 4v5h-5',
  macros: 'M8 5v14l11-7L8 5Z',
  quickconnect: 'M13 3 5 14h6l-1 7 8-11h-6l1-7Z',
  import: 'M12 3v11m0 0-4-4m4 4 4-4M4 17v3h16v-3',
  colors: 'M12 3a9 9 0 1 0 0 18c1.5 0 2-1 1.5-2.2-.5-1.3.4-2.3 1.7-2.3H18a3 3 0 0 0 3-3c0-5-4-10.5-9-10.5ZM7.5 11.5h.01M10 7.5h.01M15 8h.01',
  panes: 'M4 5h16v14H4V5Zm8 0v14m0-7h8',
};
// Référencement : image de partage seulement si public/og.png existe ; JSON-LD du logiciel.
const ogImage = hasOgImage() ? new URL('/og.png', Astro.site).href : undefined;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Escale',
  description: t.meta.description,
  url: canonical,
  operatingSystem: 'macOS 15',
  applicationCategory: 'DeveloperApplication',
  softwareVersion: release.version,
  downloadUrl: new URL(downloadURL, Astro.site).href,
  fileSize: `${release.sizeMB} MB`,
  inLanguage: t.lang,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <!-- Icônes générées depuis favicon.svg par scripts/favicons.mjs ; l'ICO sert les navigateurs sans SVG. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffd24a" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Escale" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.meta.locale} />
    <meta property="og:locale:alternate" content={locale === 'en' ? fr.meta.locale : en.meta.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={t.meta.ogAlt} />
          <meta name="twitter:image" content={ogImage} />
          <meta name="twitter:image:alt" content={t.meta.ogAlt} />
        </>
      )
    }
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <script is:inline>
      // Le module de mouvement prend la main ; filet de sécurité : tout redevient visible après 3 s.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(min-width: 768px)').matches) {
        document.documentElement.setAttribute('data-motion', '');
        setTimeout(() => document.documentElement.removeAttribute('data-motion'), 3000);
      }
    </script>
  </head>
  <body class="min-h-dvh font-sans">
    <!-- Fond d'écran : aplats ambre qui se recouvrent, découpés comme les volets de l'icône. -->
    <div class="wallpaper pointer-events-none fixed inset-0 -z-10 hidden overflow-hidden md:block" aria-hidden="true">
      <span class="flap" style="--x:-14vw;--y:78vh;--w:30vw;--h:46vh;--c:var(--color-amber-pale)"></span>
      <span class="flap" style="--x:74vw;--y:-22vh;--w:46vw;--h:56vh;--c:var(--color-amber-lo)"></span>
      <span class="flap" style="--x:70vw;--y:52vh;--w:40vw;--h:62vh;--c:var(--color-amber-deep)"></span>
      <span class="flap" style="--x:30vw;--y:88vh;--w:36vw;--h:40vh;--c:#ffc21a"></span>
    </div>

    <!-- Barre des menus -->
    <header class="sticky top-0 z-40 border-b border-ink/10 bg-amber-hi/75 backdrop-blur-xl backdrop-saturate-150">
      <nav class="mx-auto flex h-11 max-w-[1240px] items-center gap-6 px-5 text-[14px]">
        <a href={`${base}/`} class="flex items-center gap-2 font-bold">
          <img src="/favicon.svg" alt="" width="22" height="22" />
          <span>Escale</span>
        </a>
        <ul class="hidden items-center gap-5 md:flex">
          <li><a class="opacity-80 hover:opacity-100" href="#features">{t.nav.features}</a></li>
          <li class="hidden lg:block"><a class="opacity-80 hover:opacity-100" href="#more">{t.nav.more}</a></li>
          <li><a class="opacity-80 hover:opacity-100" href="#protocols">{t.nav.protocols}</a></li>
          <li><a class="opacity-80 hover:opacity-100" href="#security">{t.nav.security}</a></li>
          <li><a class="opacity-80 hover:opacity-100" href="#faq">{t.nav.faq}</a></li>
        </ul>
        <div class="ml-auto flex items-center gap-4">
          <!-- Lien de dons : discret (texte), le bouton Télécharger reste la seule action principale. -->
          <a href={SUPPORT_URL} target="_blank" rel="noopener" aria-label={t.support.navLabel} class="-m-2 flex items-center gap-1.5 p-2 opacity-80 hover:opacity-100">
            <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><path d={cup} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="hidden sm:inline">{t.support.nav}</span>
          </a>
          <a href={t.nav.otherHref} hreflang={t.nav.otherLang.toLowerCase()} aria-label={t.nav.otherLangLabel} class="font-mono text-[12px] font-semibold opacity-75 hover:opacity-100">{t.nav.otherLang}</a>
          <a href={downloadURL} data-download class="rounded-full bg-ink px-3.5 py-1.5 text-[13px] font-semibold text-amber-hi hover:bg-panel-hi">{t.nav.download}</a>
        </div>
      </nav>
    </header>

    <main>
      <!-- Héros : l'app d'abord. Un seul <picture> ; l'ordre (mobile : capture avant les puces) vient de `order`. -->
      <section id="top" class="mx-auto grid max-w-[1240px] grid-cols-[minmax(0,1fr)] px-5 pt-8 pb-16 md:pt-12 lg:pb-24">
        <div class="order-1" data-stagger>
          <p class="font-mono text-[14px] font-medium tracking-tight">{t.hero.kicker}</p>
          <h1 class="display mt-4 text-[clamp(2.2rem,5.6vw,4.5rem)] leading-[0.98] [text-wrap:balance]">
            {t.hero.title.map((l) => <span class="block">{l}</span>)}
          </h1>
          <p class="mt-5 max-w-[46rem] text-[18px] leading-[1.5] text-ink/90 md:text-[19px] [text-wrap:pretty]">{t.hero.lead}</p>
          <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-4">
            <a href={downloadURL} data-download class="cta inline-flex items-center gap-3 rounded-2xl bg-ink px-7 py-[1.1rem] text-[18px] font-semibold text-amber-hi shadow-[0_10px_30px_-10px_rgb(22_23_27/0.6)]">
              <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2v11m0 0-4.5-4.5M10 13l4.5-4.5M3 17h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              {t.hero.cta}
            </a>
          </div>
        </div>
        <div class="relative order-2 mt-8 md:order-3 md:mt-8 min-[1360px]:-mx-10" data-reveal data-hero-shot>
          <Shot
            name="hero"
            mobile="hero-mobile"
            alt={t.hero.shotAlt}
            zoomLabel={t.zoom.open}
            eager
            widths={[800, 1280, 1920, 2880]}
            sizes="(min-width: 1360px) 1280px, (min-width: 1240px) 1200px, calc(100vw - 40px)"
          />
          <!-- Repères : pastilles vers les sections, ordinateur seulement. Positions (%) dans hero.callouts. -->
          <ul class="pointer-events-none absolute inset-0 hidden md:block">
            {
              t.hero.callouts.map((c) => (
                <li class="pointer-events-auto absolute -translate-x-1/2 -translate-y-1/2" style={`left:${c.x}%;top:${c.y}%`}>
                  <a href={c.href} class="inline-flex items-center gap-2 rounded-full bg-amber-hi px-3.5 py-2 font-mono text-[14px] font-semibold whitespace-nowrap text-ink shadow-[0_10px_24px_-6px_rgb(0_0_0/0.7)] ring-2 ring-ink/80 transition-colors hover:bg-amber-pale">
                    <span class="size-2.5 rounded-full bg-ink" aria-hidden="true" />
                    {c.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <ul class="order-3 mt-6 flex flex-wrap items-center gap-2 font-mono text-[14px] font-medium text-ink/90 md:order-2 md:mt-7">
          {t.hero.meta.map((m) => <li class="rounded-full border border-ink/25 px-2.5 py-0.5">{m}</li>)}
          <li>
            <a href={SUPPORT_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full border border-dashed border-ink/40 px-2.5 py-0.5 whitespace-nowrap transition-colors hover:border-ink hover:bg-ink hover:text-amber-hi">
              <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d={cup} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              {t.support.hero}
            </a>
          </li>
        </ul>
      </section>

      <!-- Fonctions : l'image prend 7/12 (8/12 dès xl) ; une fonction sans capture (X11) passe ses points en panneau. -->
      <section id="features" class="mx-auto max-w-[1240px] px-5 py-16 md:py-24">
        <h2 class="display max-w-[18ch] text-[clamp(2.1rem,4.4vw,3.6rem)] leading-[1.02]" data-reveal>{t.features.title}</h2>
        <div class="mt-16 grid gap-24 md:mt-20 md:gap-32">
          {
            t.features.items.map((f, i) => {
              const media = hasMedia(f.shot);
              return (
                <article id={f.id} class:list={['grid grid-cols-[minmax(0,1fr)] items-center gap-10 lg:gap-14', i % 2 ? 'lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] xl:grid-cols-[minmax(0,8fr)_minmax(0,4fr)]' : 'lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] xl:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]']}>
                  <div class:list={[i % 2 && 'lg:order-2']} data-stagger>
                    <p class="inline-flex items-center gap-2 rounded-full bg-ink/90 px-3 py-1 text-[13px] font-semibold text-amber-hi">
                      <span class="size-2 rounded-full bg-amber-hi" />
                      {f.label}
                    </p>
                    <h3 class="mt-5 text-[clamp(1.7rem,2.8vw,2.35rem)] leading-[1.08] font-bold tracking-[-0.02em] [font-stretch:104%] [text-wrap:balance]">{f.title}</h3>
                    <p class="mt-5 text-[17px] leading-[1.6] text-ink/90 [text-wrap:pretty]">{f.body}</p>
                    {media && (
                      <ul class="mt-6 grid gap-2 font-mono text-[14px]">
                        {f.points.map((p) => (
                          <li class="flex gap-3">
                            <span aria-hidden="true" class="font-bold">›</span>
                            <span>{p}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                  {media ? (
                    <div data-reveal>
                      <Shot
                        name={f.shot}
                        mobile={`${f.shot}-mobile`}
                        video
                        alt={t.shots[f.shot as keyof typeof t.shots]}
                        zoomLabel={t.zoom.open}
                        sizes="(min-width: 1360px) 800px, (min-width: 1024px) 58vw, calc(100vw - 40px)"
                      />
                    </div>
                  ) : (
                    <ul class="grid gap-3 rounded-[20px] bg-panel p-4 font-mono text-[14px] text-amber-hi shadow-[0_30px_60px_-24px_rgb(80_40_0/0.6)] sm:grid-cols-3 sm:p-5" data-stagger>
                      {f.points.map((p, n) => (
                        <li class="grid content-between gap-8 rounded-[12px] bg-panel-hi p-4">
                          <span class="text-[13px] text-amber-hi/70" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
                          <span class="leading-snug font-medium text-white/90">{p}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </article>
              );
            })
          }
        </div>
      </section>

      <!-- Le reste : grille de tuiles. Une capture tile-<id>.png la complète ; sans elle, une icône. -->
      <section id="more" class="mx-auto max-w-[1240px] px-5 py-16 md:py-24">
        <h2 class="display max-w-[22ch] text-[clamp(2.1rem,4.4vw,3.6rem)] leading-[1.02]" data-reveal>{t.more.title}</h2>
        <ul class="mt-12 grid grid-cols-[minmax(0,1fr)] gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5" data-stagger>
          {
            t.more.items.map((m) => {
              const hasShot = !!shot(`tile-${m.id}`);
              return (
                <li class:list={['flex flex-col rounded-[22px] bg-paper p-6 shadow-[0_24px_48px_-24px_rgb(80_40_0/0.5)] ring-1 ring-ink/10', m.wide && 'sm:col-span-2', m.id === 'panes' && 'sm:col-span-2 lg:col-span-1']}>
                  {!hasShot && (
                    <span class="mb-5 grid size-11 place-items-center rounded-xl bg-ink text-amber-hi" aria-hidden="true">
                      <svg width="22" height="22" viewBox="0 0 24 24"><path d={tileIcons[m.id]} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </span>
                  )}
                  <h3 class="text-[20px] leading-tight font-bold tracking-[-0.01em] [font-stretch:104%]">{m.t}</h3>
                  <p class="mt-2.5 text-[16px] leading-[1.55] text-ink/90 [text-wrap:pretty]">{m.d}</p>
                  {hasShot && (
                    <div class="mt-auto pt-6">
                      <Shot
                        name={`tile-${m.id}`}
                        mobile={`tile-${m.id}-mobile`}
                        mobileSizes="calc(100vw - 88px)"
                        small
                        alt={m.alt}
                        zoomLabel={t.zoom.open}
                        widths={[600, 1200, 2400]}
                        imgClass="block h-auto w-full"
                        sizes={m.wide ? '(min-width: 1024px) 760px, (min-width: 640px) 90vw, calc(100vw - 88px)' : '(min-width: 1024px) 380px, (min-width: 640px) 45vw, calc(100vw - 88px)'}
                      />
                    </div>
                  )}
                </li>
              );
            })
          }
        </ul>
      </section>

      <!-- Protocoles : tableau des départs -->
      <section id="protocols" class="mx-auto max-w-[1240px] px-5 py-16 md:py-24">
        <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:items-end">
          <!-- Taille du titre rapportée à SA colonne (cqi) et à la longueur du mot, pas à la fenêtre : « Departures » (EN,
               ~0,55 em par lettre) débordait sur le tableau dans la colonne 4/12. 0,6 em par lettre garde une marge ;
               un titre court (« Départs ») reste au plafond de 5rem. -->
          <div class="@container" data-reveal>
            <h2
              class="display text-[clamp(2.8rem,calc(100cqi/(var(--chars)*0.6)),5rem)] leading-[0.95]"
              style={`--chars:${[...t.protocols.title].length}`}
            >{t.protocols.title}</h2>
            <p class="mt-5 max-w-[22rem] text-[18px] leading-[1.5] text-ink/90">{t.protocols.lead}</p>
          </div>
          <div class="board rounded-[18px] bg-panel p-3 text-amber-hi shadow-[0_30px_60px_-24px_rgb(80_40_0/0.6)] sm:p-4" data-reveal>
            <div class="hidden grid-cols-[9rem_6rem_minmax(0,1fr)] gap-3 px-3 pb-2 font-mono text-[11.5px] tracking-[0.12em] text-amber-hi/70 uppercase sm:grid">
              {t.protocols.cols.map((c) => <span>{c}</span>)}
            </div>
            <ul class="grid gap-1.5" data-stagger>
              {
                t.protocols.rows.map((r) => (
                  <li class="row grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 rounded-[10px] bg-panel-hi px-3.5 py-3 font-mono sm:grid-cols-[9rem_6rem_minmax(0,1fr)]">
                    <span class="text-[18px] font-bold tracking-wide sm:text-[19px]">{r.p}</span>
                    <span class="text-[15px] text-amber-hi/80">{r.port}</span>
                    <span class="col-span-2 text-[14px] text-white/85 sm:col-span-1 sm:text-[14.5px]">{r.d}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <!-- Sécurité -->
      <section id="security" class="mx-auto max-w-[1240px] px-5 py-16 md:py-24">
        <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
          <h2 class="display text-[clamp(2.1rem,4.4vw,3.6rem)] leading-[1.02] lg:sticky lg:top-24 lg:self-start" data-reveal>{t.security.title}</h2>
          <dl class="grid border-t-2 border-ink" data-stagger>
            {
              t.security.items.map((s) => (
                <div class="grid grid-cols-[minmax(0,1fr)] gap-2 border-b border-ink/20 py-6 sm:grid-cols-[14rem_minmax(0,1fr)] sm:gap-8">
                  <dt class="text-[18px] font-bold tracking-[-0.01em]">{s.t}</dt>
                  <dd class="text-[16.5px] leading-[1.6] text-ink/90">{s.d}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- Téléchargement -->
      <section id="download" class="mx-auto max-w-[1240px] px-5 py-16 md:py-24">
        <div class="relative overflow-clip rounded-[28px] bg-panel text-white shadow-[0_40px_80px_-30px_rgb(80_40_0/0.7)]" data-reveal>
          <div class="relative grid grid-cols-[minmax(0,1fr)] gap-12 p-8 sm:p-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:p-16">
            <div>
              <img src="/favicon.svg" alt="" width="88" height="88" class="drop-shadow-[0_8px_16px_rgb(0_0_0/0.4)]" />
              <h2 class="display mt-8 text-[clamp(2.2rem,4.6vw,3.8rem)] leading-[1.02] text-amber-hi">{t.download.title}</h2>
              <p class="mt-6 max-w-[30rem] text-[18px] leading-[1.55] text-white/80">{t.download.lead}</p>
              <a href={downloadURL} data-download class="cta mt-9 inline-flex items-center gap-3 rounded-2xl bg-amber-hi px-6 py-4 text-[17px] font-semibold text-ink hover:bg-amber-pale">
                <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2v11m0 0-4.5-4.5M10 13l4.5-4.5M3 17h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                {t.download.cta}
              </a>
              <p class="mt-4 font-mono text-[13px] text-white/70">{t.download.file}</p>
              <p class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-white/12 pt-6 text-[15px] text-white/80">
                {t.support.lead}
                <a href={SUPPORT_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-amber-hi/60 px-3.5 py-1.5 text-[14px] font-semibold text-amber-hi hover:bg-amber-hi hover:text-ink">
                  <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d={cup} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  {t.support.cta}
                </a>
              </p>
            </div>
            <div class="self-end">
              <dl class="grid gap-0 font-mono text-[13.5px]">
                {
                  t.download.specs.map(([k, v]) => (
                    <div class="grid grid-cols-[7.5rem_minmax(0,1fr)] gap-4 border-b border-white/12 py-3.5">
                      <dt class="text-amber-hi/70">{k}</dt>
                      <dd class="text-white/90">{v}</dd>
                    </div>
                  ))
                }
              </dl>
              <p class="mt-6 text-[14.5px] leading-[1.55] text-white/70">{t.download.note}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Questions -->
      <section id="faq" class="mx-auto max-w-[1240px] px-5 py-16 md:py-24">
        <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
          <h2 class="display text-[clamp(2.1rem,4.4vw,3.6rem)] leading-[1.02]" data-reveal>{t.faq.title}</h2>
          <div class="grid border-t-2 border-ink" data-stagger>
            {
              t.faq.items.map((f) => (
                <details class="group border-b border-ink/20">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[18px] font-semibold [&::-webkit-details-marker]:hidden">
                    {f.q}
                    <span class="grid size-8 shrink-0 place-items-center rounded-full bg-ink text-amber-hi transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                  </summary>
                  <p class="max-w-[42rem] pb-6 text-[16.5px] leading-[1.6] text-ink/90">{f.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="mx-auto max-w-[1240px] px-5 pt-10 pb-32 text-[14px]">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-ink/20 pt-6">
        <span class="flex items-center gap-2 font-semibold"><img src="/favicon.svg" alt="" width="18" height="18" />{t.footer.line}</span>
        <a href={SUPPORT_URL} target="_blank" rel="noopener" class="ml-auto opacity-80 underline-offset-4 hover:underline hover:opacity-100">{t.support.footer}</a>
      </div>
    </footer>

    <!-- Dock (navigation, ordinateur seulement) -->
    <nav class="dock fixed bottom-4 left-1/2 z-40 hidden -translate-x-1/2 md:block" aria-label="Sections" data-dock-bar>
      <ul class="flex items-end gap-2 rounded-[22px] border border-white/40 bg-white/30 p-2 shadow-[0_20px_40px_-16px_rgb(80_40_0/0.55)] backdrop-blur-2xl backdrop-saturate-150">
        {
          [
            { href: '#top', label: t.dock.home, icon: 'app' },
            { href: '#features', label: t.dock.features, icon: 'prompt' },
            { href: '#protocols', label: t.dock.protocols, icon: 'board' },
            { href: '#security', label: t.dock.security, icon: 'lock' },
            { href: '#download', label: t.dock.download, icon: 'down' },
          ].map((d) => (
            <li class="relative">
              <a href={d.href} data-dock={d.href.slice(1)} class="dock-item group relative grid size-12 place-items-center rounded-[13px] bg-panel text-amber-hi shadow-[inset_0_-1px_0_rgb(0_0_0/0.5)]" aria-label={d.label}>
                <span class="tip pointer-events-none absolute -top-9 rounded-md bg-ink/85 px-2 py-1 text-[12px] font-medium whitespace-nowrap text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">{d.label}</span>
                {d.icon === 'app' && <img src="/favicon.svg" alt="" width="48" height="48" class="size-12 scale-[1.18]" />}
                {d.icon === 'prompt' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7l5 5-5 5M13 17h6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                )}
                {d.icon === 'board' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
                )}
                {d.icon === 'lock' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" fill="currentColor" /><path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2.4" /></svg>
                )}
                {d.icon === 'down' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                )}
              </a>
              <span class="dot absolute -bottom-1.5 left-1/2 size-1 -translate-x-1/2 rounded-full bg-ink opacity-0" aria-hidden="true" />
            </li>
          ))
        }
        <!-- Lien externe : séparé des sections, sans data-dock (jamais marqué comme section active). -->
        <li class="mx-0.5 h-10 w-px self-center bg-ink/20" aria-hidden="true"></li>
        <li class="relative">
          <a href={SUPPORT_URL} target="_blank" rel="noopener" class="dock-item group relative grid size-12 place-items-center rounded-[13px] bg-amber-hi text-ink shadow-[inset_0_-1px_0_rgb(0_0_0/0.25)]" aria-label={t.support.navLabel}>
            <span class="tip pointer-events-none absolute -top-9 rounded-md bg-ink/85 px-2 py-1 text-[12px] font-medium whitespace-nowrap text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">{t.support.cta}</span>
            <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d={cup} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Zoom des captures : une seule boîte, remplie au clic par [data-zoom]. Clic sur l'image = taille réelle. -->
    <dialog data-lightbox aria-label={t.zoom.open} class="fixed inset-0 m-0 size-full max-h-none max-w-none overflow-auto bg-transparent p-0 backdrop:bg-ink/90">
      <div data-lb-wrap class="flex min-h-full p-4 sm:p-8">
        <img data-lb-img alt="" class="m-auto max-h-[calc(100dvh-2rem)] max-w-full cursor-zoom-in rounded-lg object-contain shadow-2xl sm:max-h-[calc(100dvh-4rem)]" />
      </div>
      <button type="button" data-lb-close aria-label={t.zoom.close} class="fixed top-3 right-3 z-10 grid size-10 place-items-center rounded-full bg-amber-hi text-ink shadow-lg hover:bg-amber-pale">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>
      </button>
    </dialog>

    <!-- Remerciement après un clic sur Télécharger : une fois par visite, jamais avant le téléchargement. -->
    <div class="thanks fixed bottom-[max(1rem,env(safe-area-inset-bottom))] left-1/2 md:bottom-24 z-50 w-[min(92vw,30rem)] -translate-x-1/2" role="status" aria-live="polite" data-thanks hidden>
      <div class="flex items-center gap-3 rounded-2xl bg-ink py-3 pr-2 pl-4 ring-1 ring-white/15 text-[14px] text-white/85 shadow-[0_12px_32px_-10px_rgb(0_0_0/0.6)]">
        <p class="min-w-0 flex-1">
          {t.support.thanks}{' '}
          <a href={SUPPORT_URL} target="_blank" rel="noopener" class="font-semibold whitespace-nowrap text-amber-hi underline-offset-4 hover:underline">{t.support.cta}</a>
        </p>
        <button type="button" class="grid size-10 shrink-0 place-items-center rounded-full text-white/60 hover:bg-white/10 hover:text-white" aria-label={t.support.close} data-thanks-close>
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
        </button>
      </div>
    </div>

    <style>
      .flap {
        position: absolute;
        left: var(--x);
        top: var(--y);
        width: var(--w);
        height: var(--h);
        border-radius: 6vw;
        background: var(--c);
      }
      /* Charnière des volets du fond d'écran */
      .flap::after {
        content: '';
        position: absolute;
        inset: 50% 0 auto;
        height: 1.1vw;
        min-height: 6px;
        background: var(--color-amber-hi);
        opacity: 0.9;
      }
      html:has(dialog[open]) { overflow: hidden; }
      [data-lightbox].full [data-lb-img] { max-width: none; max-height: none; cursor: zoom-out; }
      .cta { transition: transform 0.2s var(--ease-out-expo), background-color 0.2s; }
      @media (hover: hover) and (min-width: 640px) {
        .cta:hover { transform: translateY(-2px); }
      }
      /* Le Dock n'apparaît qu'une fois le héros dépassé : il ne masque jamais l'appel à l'action. */
      .dock { transition: opacity 0.3s, transform 0.4s var(--ease-out-expo); }
      .dock:not(.shown) { opacity: 0; transform: translate(-50%, 24px); pointer-events: none; }
      .dock-item { transition: transform 0.25s var(--ease-out-expo); transform-origin: bottom center; }
      @media (hover: hover) {
        .dock-item:hover { transform: scale(1.18) translateY(-4px); }
      }
      .dock [aria-current='true'] + .dot { opacity: 1; }
      .thanks { transition: opacity 0.3s, transform 0.4s var(--ease-out-expo); }
      .thanks:not(.shown) { opacity: 0; transform: translate(-50%, 12px); pointer-events: none; }
      @media (prefers-reduced-motion: reduce) {
        .dock-item, .cta, .thanks { transition: none; }
        .dock-item:hover, .cta:hover { transform: none; }
      }
    </style>

    <script>
      import { animate, inView, stagger } from 'motion';

      const root = document.documentElement;
      if (root.hasAttribute('data-motion')) {
        const groups = document.querySelectorAll<HTMLElement>('[data-reveal], [data-stagger]');
        groups.forEach((g) => {
          const targets = g.hasAttribute('data-stagger') ? Array.from(g.children) as HTMLElement[] : [g];
          targets.forEach((el) => (el.style.opacity = '0'));
        });
        root.removeAttribute('data-motion');
        groups.forEach((g) => {
          const targets = g.hasAttribute('data-stagger') ? Array.from(g.children) as HTMLElement[] : [g];
          inView(
            g,
            () => {
              animate(
                targets,
                { opacity: [0, 1], y: [16, 0] },
                { type: 'spring', stiffness: 240, damping: 30, delay: stagger(0.06) },
              );
            },
            { amount: 0.2 },
          );
        });
      }

      // Pastille du Dock sous la section visible.
      const items = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-dock]'));
      const sections = items
        .map((a) => document.getElementById(a.dataset.dock!))
        .filter((s): s is HTMLElement => !!s);
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            items.forEach((a) => a.setAttribute('aria-current', String(a.dataset.dock === e.target.id)));
          });
        },
        { rootMargin: '-45% 0px -50% 0px' },
      );
      sections.forEach((s) => io.observe(s));

      const bar = document.querySelector<HTMLElement>('[data-dock-bar]');
      const hero = document.getElementById('top');
      if (bar && hero) {
        new IntersectionObserver(([e]) => bar.classList.toggle('shown', !e.isIntersecting), { threshold: 0.15 }).observe(hero);
      }

      // Boucles vidéo : lues seulement à l'écran ; mouvement réduit = affiche + commandes, jamais de lecture auto.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll<HTMLVideoElement>('video[data-clip]').forEach((v) => {
        v.muted = true;
        if (reduce) {
          v.controls = true;
          return;
        }
        new IntersectionObserver(
          ([e]) => {
            if (e.isIntersecting) v.play().catch(() => {});
            else v.pause();
          },
          { threshold: 0.25 },
        ).observe(v);
      });

      // Zoom : la plus grande variante de la capture cliquée (recadrage portrait sous 768 px s'il existe).
      const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
      const boxImg = box?.querySelector<HTMLImageElement>('[data-lb-img]');
      if (box && boxImg) {
        document.addEventListener('click', (e) => {
          const b = (e.target as Element).closest<HTMLElement>('[data-zoom]');
          if (!b) return;
          const small = matchMedia('(max-width: 767px)').matches;
          boxImg.src = (small && b.dataset.zoomM) || b.dataset.zoom || '';
          boxImg.alt = b.dataset.zoomAlt || '';
          box.classList.remove('full');
          box.showModal();
        });
        box.addEventListener('click', (e) => {
          const el = e.target as Element;
          if (el === boxImg) box.classList.toggle('full');
          else if (el === box || el.hasAttribute('data-lb-wrap') || el.closest('[data-lb-close]')) box.close();
        });
        box.addEventListener('close', () => boxImg.removeAttribute('src'));
      }

      // Bandeau de remerciement : le lien de téléchargement n'est ni bloqué ni modifié.
      const thanks = document.querySelector<HTMLElement>('[data-thanks]');
      if (thanks) {
        let timer = 0;
        const hide = () => {
          clearTimeout(timer);
          thanks.classList.remove('shown');
          setTimeout(() => (thanks.hidden = true), 400);
          document.removeEventListener('keydown', onKey);
        };
        const onKey = (e: KeyboardEvent) => e.key === 'Escape' && hide();
        const seen = () => {
          try { return sessionStorage.getItem('escale-thanks') === '1'; } catch { return false; }
        };
        document.querySelectorAll('[data-download]').forEach((a) =>
          a.addEventListener('click', () => {
            if (seen()) return;
            try { sessionStorage.setItem('escale-thanks', '1'); } catch {}
            thanks.hidden = false;
            requestAnimationFrame(() => requestAnimationFrame(() => thanks.classList.add('shown')));
            document.addEventListener('keydown', onKey);
            timer = window.setTimeout(hide, 8000);
          }),
        );
        thanks.addEventListener('mouseenter', () => clearTimeout(timer));
        thanks.addEventListener('focusin', () => clearTimeout(timer));
        thanks.querySelector('[data-thanks-close]')?.addEventListener('click', hide);
      }
    </script>
  </body>
</html>
