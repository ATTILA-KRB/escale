{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/updates/appcast.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/updates/(.*)\\.dmg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-apple-diskimage"
        }
      ]
    }
  ]
}
